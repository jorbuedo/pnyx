*~

# OS
.DS_Store
Thumbs.db

# Expo
.expo/

# Native build dirs (generated by Expo prebuild, wallet app only)
/app/ios/
/app/android/

# Gradle's per-project build cache. Machine-local state (file hashes, lock files); the
# packages' own android/ dirs carry real sources and stay tracked.
.gradle/

# E2E testing
# Note: ELF files in packages/hardware/e2e/apps/ are committed to avoid build times in CI
packages/hardware/e2e/.build/

# Rust
services/**/target/
*.rustc_info.json

# Generated files
*.generated.ts
*.generated.json
# Exception: bundles.generated.ts is needed at compile time by script-generator.ts
!packages/dapp-connector/scripts/bundles.generated.ts

# Claude Code
.claude/reports/
.claude/worktrees/
.claude/commands/
.claude/cache/
.claude/agent-memory/
CLAUDE.local.md

# Local MD files for AI plans or whatever
_*.md
*.tar.gz
*.app

# Local agent / IDE-history state
.agents/
.history/

# Mobile flow test credentials (contains mnemonics)
.claude/skills/mobile-flow-test/local-test-credentials.json

# E2E test reports and screenshots
app/e2e/reports/

# Local-only product-handoff prototype-screenshot tool
/app/scripts/proto-shot.ts
/product/tools/


# Local AI/RAG tool state (ruvector embedded vector DB, scratch files)
ruvector.db
/temp

# --- Pnyx (Midnight) ---
contract/managed/
.preprod-wallet.json
# One snapshot per wallet: a dust snapshot is one dust key's state, so it cannot be shared.
.preprod-dust-state.gz
.preprod-dust-state.*.gz
.states/
logs/
services/content/.data/
.local-deploy.json
services/content/midnight-level-db/
midnight-level-db/

# Firebase configs — real files come from GitHub secrets (CI) or `firebase apps:sdkconfig` (local);
# committed *.example placeholders keep fresh clones building. See scripts/inject-firebase-configs.sh
app/google-services.json
app/google-services.dev.json
app/GoogleService-Info.plist
app/GoogleService-Info.dev.plist
services/content/.secrets/
.preprod-deploy.json
# A local record of the preprod circle deploy — public values, but a run artifact like the rest.
.preprod-circle.json
# payment.compact's preprod address AND its grant secret in the clear — whoever holds that mints
# permits for free and reprices every tier, for the life of the namespace, with no rotation path.
# ⚠️ GLOB, not the bare name: `.preprod-payment.weak-admin-b31317a5.json.bak` was tracked for two
# months because a `.bak` suffix walked straight past `.preprod-payment.json`.
.preprod-payment*
.preprod-test-token.json
# The claimed handle's derived address and bind tx. No secret, but it is per-machine state.
.preprod-handle.json
# Registered identity + its recovery phrase, from harness/register-identity-preprod.ts.
.preprod-identity.log
# Written per-build by scripts/ensure-env.ts (and a dev may keep their own).
app/.env.local
app/.env.local.before-build

# Cloudflare wrangler local state
.wrangler/
**/.wrangler/

# Wrangler local secrets (JWT_PRIVATE_KEY etc). Never committed.
.dev.vars
.dev.vars.*

# Translation scratch: chunked English and per-locale output, written by
# app/scripts/i18n/. Regenerated on demand, never committed.
app/.i18n-work/

# The public snapshot's build tree (infra/open-source/run-export-snapshot.ts --out).
.snapshot-build/
