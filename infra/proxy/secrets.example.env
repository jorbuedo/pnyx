# Copy to /etc/pnyx-proxy/secrets.env, fill in, and `chmod 600`. The proxy REFUSES TO START if this
# file is group- or world-readable — it is the one place these values exist, and the reason the app
# no longer carries them.
#
# ⚠️ Never commit a filled copy. Never put these in proxy.toml, which is committed.

# The Pnyx partner key SteelSwap attributes the swap fee to. The first credential this proxy was
# built for. ⚠️ We cannot rotate it ourselves; a replacement is a request to SteelSwap.
STEELSWAP_API_KEY=

# Blockfrost, PER MIDNIGHT NETWORK — a project_id belongs to one network and 403s on any other.
# The proxy spends FREE to its daily quota and then PAID, logging one line at the switch.
BLOCKFROST_MIDNIGHT_PREPROD_FREE=
# ⚠️ A key declared in proxy.toml whose secret is blank or absent here FAILS THE BOOT, so this one
# is commented out rather than left empty until there is a paid project to put in it.
# BLOCKFROST_MIDNIGHT_PREPROD_PAID=

# ▶ Add BLOCKFROST_MIDNIGHT_MAINNET_* / _PREVIEW_* alongside their own credential blocks in
# proxy.toml when those projects exist. Mainnet currently runs through our own indexer with no key.
