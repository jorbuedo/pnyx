# Copy to /etc/sponsor/sponsor.preview.env on the box, chmod 0600, owned by the sponsor user.
# Read by sponsor@preview.service AFTER sponsor.env, so anything here overrides the shared value.
#
# Preview: the network the app's funds selector defaults to for testing.

MIDNIGHT_NETWORK=preview

# Loopback only, and unique per network — the router in front dials it. cloudflared points at the
# router (3400), not at any wallet, so the tunnel's ingress rule never changes when a network is added.
PORT=3401

# Dust-sync snapshot. Seed-specific AND chain-specific: delete the file if either changes, or the wallet
# resumes from a state that belongs to something else. Without it every restart pays a cold sync.
CHAIN_DUST_STATE_FILE=/var/lib/sponsor/dust-state.preview.gz

# Replayed on boot: what this network's sponsor has already promised to submit. One per network, because
# a job is only replayable onto the chain it was built for.
SPONSOR_BACKLOG_FILE=/var/lib/sponsor/backlog.preview.json

# Plain sends are funded here: preview is where the wallet's own send flows are tested, and a phone
# cannot pay a DUST fee before it has synced DUST.
SPONSOR_FUND_TRANSFERS=1

# Below this the host reports `degraded` on /status — it can still sponsor, but not for long. Unset means
# no floor is configured and only true exhaustion is called out; no threshold is invented.
# SPONSOR_DUST_FLOOR=

# Optional endpoint overrides. Unset uses this network's official rail, which is what all three want.
# CHAIN_INDEXER_URL=
# CHAIN_INDEXER_WS_URL=
# CHAIN_NODE_URL=
# CHAIN_NODE_WS_URL=
