# Copy to /etc/sponsor/sponsor.mainnet.env on the box, chmod 0600, owned by the sponsor user.
# Read by sponsor@mainnet.service AFTER sponsor.env, so anything here overrides the shared value.
#
# Mainnet: real DUST. ⚠️ This wallet has no DUST until NIGHT is delegated to its DUST address, and
# `ensureDust` waits for it in a 10s poll rather than failing — so the unit sits at 503 `starting`
# indefinitely and comes alive by itself once DUST appears. That is the intended state before the
# delegation lands; the router reports mainnet `starting` and refuses to route to it.

MIDNIGHT_NETWORK=mainnet

# Loopback only, and unique per network — the router in front dials it. cloudflared points at the
# router (3400), not at any wallet, so the tunnel's ingress rule never changes when a network is added.
PORT=3403

# Dust-sync snapshot. Seed-specific AND chain-specific: delete the file if either changes, or the wallet
# resumes from a state that belongs to something else. Without it every restart pays a cold sync.
CHAIN_DUST_STATE_FILE=/var/lib/sponsor/dust-state.mainnet.gz

# Replayed on boot: what this network's sponsor has already promised to submit. One per network, because
# a job is only replayable onto the chain it was built for.
SPONSOR_BACKLOG_FILE=/var/lib/sponsor/backlog.mainnet.json

# ⚠️ **Plain sends are funded here too — with real DUST.** Decided deliberately (2026-08-28): a phone
# cannot pay a DUST fee before it has synced DUST, and that is as true on mainnet as anywhere. It is the
# one sponsorship clause not bounded by our own contracts, so the only bound is the Worker's per-subject
# rate limit. ⚠️ **The live binding is `10 requests/60s` per authenticated identity**, i.e. up to 600 an
# hour — not the 10-per-10-minutes the in-memory fallback uses. Set a DUST floor below and watch it, and
# consider a tighter limiter for mainnet than testnets share.
SPONSOR_FUND_TRANSFERS=1

# Below this the host reports `degraded` on /status — it can still sponsor, but not for long. Unset means
# no floor is configured and only true exhaustion is called out; no threshold is invented.
# SPONSOR_DUST_FLOOR=

# Optional endpoint overrides. Unset uses this network's official rail, which is what all three want.
# CHAIN_INDEXER_URL=
# CHAIN_INDEXER_WS_URL=
# CHAIN_NODE_URL=
# CHAIN_NODE_WS_URL=
