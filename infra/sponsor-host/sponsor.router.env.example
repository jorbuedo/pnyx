# Copy to /etc/sponsor/sponsor.router.env on the box, chmod 0600, owned by the sponsor user.
# Read by sponsor-router.service AFTER sponsor.env.
#
# The router holds no wallet, no seed and no state. Its whole job is to send a submission to the wallet
# process that holds that network — see services/content/src/sponsor-router.ts for why one process per
# network is forced rather than chosen.

# The port cloudflared already points at, so adding a network changes nothing on the Cloudflare side.
PORT=3400

# How long a proxied call may take. Generous because /internal/register is awaited by the caller and
# balances with an in-process prover on 2 vCPU; a short timeout turns a slow success into a retry that
# pays for the same work twice.
# SPONSOR_PROXY_TIMEOUT_MS=180000

# The router's own liveness reads. ⚠️ Must stay well under the CALLER's timeout: the content service gives
# this host 5 s and the fan-out is only as fast as its slowest wallet, so a 5 s probe let one cold-syncing
# network spend the whole budget and the public status page read `failing` while another served fine.
# SPONSOR_PROBE_TIMEOUT_MS=2000
