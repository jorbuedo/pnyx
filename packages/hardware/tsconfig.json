{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // The Ledger SDKs type their payloads as Node `Buffer` (`signPsbtBuffer`,
    // ledgerjs), so the boundary in ledger/ needs the global. Until hw-app-btc
    // 11 this leaked in transitively via tiny-secp256k1.
    "types": ["node"]
  },
  "references": [
    { "path": "../config" },
    { "path": "../logger" },
    { "path": "../storage" },
    { "path": "../wallet" },
    { "path": "../signer" }
  ],
  "include": ["./**/*.ts", "./trezor-protocol/messages.json"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "vitest.config.ts"]
}
