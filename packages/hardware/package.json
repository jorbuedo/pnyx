{
  "name": "@pnyx/hardware",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "default": "./dist/ledger.js"
    },
    "./ledger-web": {
      "types": "./dist/ledger-web.d.ts",
      "default": "./dist/ledger-web.js"
    },
    "./ledger-native": {
      "types": "./dist/ledger-native.d.ts",
      "default": "./dist/ledger-native.js"
    },
    "./ledger-apps": {
      "types": "./dist/ledger-apps.d.ts",
      "default": "./dist/ledger-apps.js"
    },
    "./trezor": {
      "types": "./dist/trezor.d.ts",
      "default": "./dist/trezor.js"
    },
    "./trezor-native": {
      "types": "./dist/trezor-native/index.d.ts",
      "default": "./dist/trezor-native/index.js"
    },
    "./trezor-native/transport/adapter": {
      "types": "./dist/trezor-native/transport/adapter.d.ts",
      "default": "./dist/trezor-native/transport/adapter.js"
    },
    "./trezor-native/usb/usb-device-api": {
      "types": "./dist/trezor-native/usb/usb-device-api.d.ts",
      "default": "./dist/trezor-native/usb/usb-device-api.js"
    },
    "./trezor-native/usb/scan": {
      "types": "./dist/trezor-native/usb/scan.d.ts",
      "default": "./dist/trezor-native/usb/scan.js"
    },
    "./trezor-web-ble": {
      "types": "./dist/trezor-web-ble/index.d.ts",
      "default": "./dist/trezor-web-ble/index.js"
    },
    "./derivation": {
      "types": "./dist/derivation.d.ts",
      "default": "./dist/derivation.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./storage": {
      "types": "./dist/wallet-storage.d.ts",
      "default": "./dist/wallet-storage.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist node_modules/.tmp"
  },
  "dependencies": {
    "@evolution-sdk/hardware-cardano": "*",
    "@evolution-sdk/review": "*",
    "@pnyx/logger": "workspace:*",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@trezor/protobuf": "1.2.1",
    "effect": "3.21.4",
    "long": "5.2.5",
    "protobufjs": "7.6.5",
    "@pnyx/config": "workspace:*",
    "@pnyx/storage": "workspace:*",
    "@pnyx/wallet": "workspace:*",
    "@pnyx/signer": "workspace:*",
    "@cardano-foundation/ledgerjs-hw-app-cardano": "8.0.0",
    "@ledgerhq/hw-app-btc": "11.3.0",
    "@ledgerhq/hw-app-eth": "7.8.10",
    "@ledgerhq/hw-app-solana": "7.10.6",
    "@ledgerhq/hw-app-trx": "6.36.5",
    "@ledgerhq/hw-transport": "6.35.6",
    "@ledgerhq/hw-transport-webhid": "6.36.0",
    "@ledgerhq/hw-transport-webusb": "6.35.0",
    "@ledgerhq/react-native-hid": "6.39.5",
    "@ledgerhq/react-native-hw-transport-ble": "6.41.0",
    "react-native-ble-plx": "3.5.1"
  },
  "devDependencies": {
    "@types/node": "25.0.9",
    "@types/web-bluetooth": "0.0.21",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  }
}
