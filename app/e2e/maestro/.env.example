# E2E Test Environment
# Copy to .env for local testing: cp .env.example .env

# App ID (set by test runner based on brand)
# MAESTRO_APP_ID=uk.pxkq.pnyx

# Build type: "devclient" for local dev with Metro, "standalone" for Maestro Cloud
# Leave empty or "devclient" for local development (connects to Metro server)
# Set to "standalone" when running on Maestro Cloud (no Metro connection), default is devclient
BUILD_TYPE=devclient

# Wallet details
WALLET_NAME=My Test Wallet
WALLET_PASSWORD=YourSecurePassword123!

# Test mnemonics - DO NOT USE FOR REAL FUNDS
# Space-separated words, flows split them using: MNEMONIC_15.split(' ')
MNEMONIC_15=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15
MNEMONIC_12=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
MNEMONIC_24=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24
