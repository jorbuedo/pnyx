# Pnyx Preview Environment
#
# PNYX_APP_ENV is NOT set in this file — it's injected per build entry
# point (eas.json's `preview` profile) so this file's preview-specific
# Sentry / remote-config settings can be safely reused by other
# brand:preview-driven flows without leaking a `preview` appEnv override.
PNYX_BUILD_VARIANT=
# Empty on purpose: no Sentry org is configured for this project. A DSN here turns on
# runtime error reporting (src/logger/index.ts inits only when it is set).
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DISABLE_AUTO_UPLOAD=true
# Content service (identity-row auth + forum) — Cloudflare Worker on D1 (pnyx.pxkq.uk).
# Load-bearing for a preview build: unset, serviceUrl() falls back to the dev loopback
# (http://10.0.2.2:3300), which resolves to nothing on a device and is cleartext a release
# build blocks. Mirrored in eas.json's `preview` profile, which never reads this file.
EXPO_PUBLIC_SERVICE_URL=https://pnyx.pxkq.uk
# The Midnight network the service puts identities on — the SINGLE source for the whole Pnyx chain
# rail: the indexer for identity-row and MidNS reads is derived from it
# (src/services/midnight/networks.ts), so there is no second endpoint variable to keep in sync.
# It must equal what /auth/config reports, and sign-in fails with `misconfigured` if it does not.
# Declared here so onboarding derives an `pnyx_id` (and its avatar) without waiting on a network call.
EXPO_PUBLIC_PNYX_NETWORK=preprod
# Midnight indexer for the DUST rail ONLY — `dustGenerationStatus` for a Cardano reward address.
# It follows the FUNDS network, not Pnyx's: DUST generation is about NIGHT held on Cardano, so a
# wallet on Cardano mainnet needs the Midnight *mainnet* indexer here even though the forum identity
# lives on preprod. Unset → the DUST screen falls back to what Cardano alone proves.
# The Pnyx/MidNS rail no longer reads this; it derives its endpoint from EXPO_PUBLIC_PNYX_NETWORK
# above (src/services/midnight/networks.ts). The two shared this variable until 2026-08-04, which made
# their two requirements unsatisfiable at once.
# Remote config JSON endpoint — placeholder domain, swap for the real host before release
EXPO_PUBLIC_REMOTE_CONFIG_URL=https://config.pxkq.uk
# ZK circuit artifacts + KZG SRS, served R2-direct like data./config.pxkq.uk (bucket
# `pnyx-artifacts`). Unset → the app falls back to the content service's /chain/artifacts, which is
# the local-dev shape: there the contract is whatever was just deployed locally, so no static bucket
# could be right.
# ⚠️ Circuit files are keyed by contract address, so a REDEPLOY needs a re-upload before a build
# pointed here can prove anything — an un-uploaded contract 404s (by design; the alternative is
# serving another deployment's prover keys). Re-upload with:
#   bun services/content/scripts/upload-artifacts.ts --contract <hex>
EXPO_PUBLIC_ARTIFACTS_URL=https://artifacts.pxkq.uk
