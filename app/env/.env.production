# Pnyx Production Environment
PNYX_BUILD_VARIANT=prod
# Empty on purpose: no Sentry org is configured for this project. A DSN here turns on
# runtime error reporting (src/logger/index.ts inits only when it is set).
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DISABLE_AUTO_UPLOAD=false
# Remote config JSON endpoint — placeholder domain, swap for the real host before release
EXPO_PUBLIC_REMOTE_CONFIG_URL=https://config.pxkq.uk
# --- Deployment identity: required, and deliberately UNSET. ---
# No production infrastructure exists yet. Filling these with the preprod hosts would be exactly the
# invented-default this system removes: a production build would silently point at preprod and look
# healthy. `bun run env:check --env=prod` therefore FAILS by design until real hosts exist — that
# failure is the accurate status of this variant, not a bug in the check.
#   EXPO_PUBLIC_SERVICE_URL=
#   EXPO_PUBLIC_PNYX_NETWORK=
#   EXPO_PUBLIC_ARTIFACTS_URL=
