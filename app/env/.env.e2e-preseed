# Pnyx E2E Testing Environment (Pre-seeded Wallet)
# Use this for tests that need a wallet already set up
PNYX_BUILD_VARIANT=
# Empty on purpose: no Sentry org is configured for this project. A DSN here turns on
# runtime error reporting (src/logger/index.ts inits only when it is set).
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DISABLE_AUTO_UPLOAD=true
# Remote config JSON endpoint (env.json files served per appEnv)
EXPO_PUBLIC_REMOTE_CONFIG_URL=http://localhost:8790

# E2E Auto-Restore Configuration
# Wallet is auto-restored on app launch, skipping onboarding
EXPO_PUBLIC_E2E_AUTO_RESTORE=true
# EXPO_PUBLIC_E2E_MNEMONIC comes from EAS secrets (e2e-preseed environment)
# EXPO_PUBLIC_E2E_WALLET_PASSWORD comes from EAS secrets (e2e-preseed environment)
# EXPO_PUBLIC_E2E_WALLET_NAME comes from EAS secrets (e2e-preseed environment)
