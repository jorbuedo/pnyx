# Pnyx Development Environment
PNYX_BUILD_VARIANT=dev
# Empty on purpose: no Sentry org is configured for this project. A DSN here turns on
# runtime error reporting (src/logger/index.ts inits only when it is set).
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DISABLE_AUTO_UPLOAD=true
# Content service (identity auth + forum) — Cloudflare Worker on D1 (pnyx.pxkq.uk).
# The auth domain is server-driven (/auth/config), so this is the only cutover knob.
EXPO_PUBLIC_SERVICE_URL=https://pnyx.pxkq.uk
# The Midnight network the above service is on. Declaring it lets onboarding derive an `pnyx_id`
# offline AND supplies the indexer for identity-row / MidNS reads, which are otherwise unavailable in
# dev (src/services/midnight/networks.ts). Verified against /auth/config at sign-in, so a wrong value
# fails loudly as `misconfigured` rather than silently deriving a different identity.
EXPO_PUBLIC_PNYX_NETWORK=preprod
# Remote config JSON endpoint (env.json files served per appEnv)
EXPO_PUBLIC_REMOTE_CONFIG_URL=https://config.pxkq.uk
# ZK circuit artifacts, keyed by contract address. Required: the old fallback fetched these from
# the content service's /chain/* routes, which 503 against the hosted Worker.
EXPO_PUBLIC_ARTIFACTS_URL=https://artifacts.pxkq.uk
EXPO_PUBLIC_MIDNIGHT_PAYMENT_ADDRESS=4593ba931d370d7b8db6d60e0cc055b1169b14e8d560ac47f35bbdae08703df3
EXPO_PUBLIC_MIDNIGHT_PAYMENT_SHIELDED_TREASURY=mn_shield-addr_preprod1ywxc2p9986usecc9xert79afzq4m9x35u62sx0a4e2tc5w6mta5ulwhc432vhrlpnvygfep3pxcdt8tgzfstesrm6tf7hjc5jgpl20g4qnup6
# CIP-171 script-verification registry (uplc.link, run by the CIP's author). Reviewing a
# transaction that runs a contract asks it whether that script hash is linked to published
# source. Unset on prod until that third-party call is signed off; unset means the review
# makes no provenance claim at all, which is not the same as saying "unverified".
EXPO_PUBLIC_CARDANO_SCRIPT_VERIFICATION_URL=https://api.uplc.link
