# Pnyx E2E Testing Environment
PNYX_BUILD_VARIANT=
# Empty on purpose: no Sentry org is configured for this project. A DSN here turns on
# runtime error reporting (src/logger/index.ts inits only when it is set).
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DISABLE_AUTO_UPLOAD=true
# Remote config JSON endpoint (env.json files served per appEnv)
EXPO_PUBLIC_REMOTE_CONFIG_URL=http://localhost:8790
