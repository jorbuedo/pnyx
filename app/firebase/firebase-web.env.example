# Firebase Web app config (web builds).
# Firebase Console -> your Pnyx Firebase project -> Project settings -> Your apps -> Add app -> Web.
# Copy the firebaseConfig values into brand env files as EXPO_PUBLIC_FIREBASE_*.

EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_APP_ID=1:YOUR_PROJECT_NUMBER:web:your-web-app-hash
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_PROJECT_NUMBER
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
