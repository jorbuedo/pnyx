{
  "name": "midnight-pnyx",
  "private": true,
  "type": "module",
  "packageManager": "bun@latest",
  "engines": {
    "node": ">=22.12"
  },
  "resolutions": {
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "axios": "1.18.1",
    "fast-uri": "3.1.4",
    "fast-xml-parser": "5.10.1",
    "js-yaml": "4.3.0",
    "lightningcss": "1.30.1",
    "lodash": "4.18.1",
    "postcss": "8.5.23",
    "protobufjs": "7.6.5",
    "react-native-ble-plx": "3.5.1",
    "sharp": "0.35.3"
  },
  "workspaces": [
    "packages/*",
    "packages/hardware/trezor-native/react-native-usb",
    "app",
    "services/*",
    "vendor/evolution-sdk/packages/evolution",
    "vendor/evolution-sdk/packages/plan",
    "vendor/evolution-sdk/packages/review",
    "vendor/evolution-sdk/packages/hardware-cardano",
    "vendor/evolution-sdk/packages/canonical",
    "vendor/evolution-sdk/packages/cip113",
    "vendor/evolution-sdk/packages/aiken-uplc",
    "vendor/evolution-sdk/packages/cips",
    "vendor/evolution-sdk/packages/dijkstra",
    "vendor/evolution-sdk/packages/cip139",
    "vendor/evolution-sdk/packages/cip30",
    "vendor/evolution-sdk/packages/backup-keys"
  ],
  "scripts": {
    "build": "bun scripts/build-fork.ts && tsc -b tsconfig.build.json",
    "check": "NODE_OPTIONS=--max-old-space-size=8192 tsc -b tsconfig.json && NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.typecheck.json && NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.tests.json",
    "check:tests": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.tests.json",
    "check:app": "cd app && bun run check",
    "type-check": "bun run check",
    "lint": "biome check .",
    "lint-fix": "biome check --write .",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "VITEST_COVERAGE=true vitest --coverage",
    "coverage": "VITEST_COVERAGE=true vitest --coverage",
    "coverage:ui": "VITEST_COVERAGE=true vitest --coverage --ui",
    "clean": "bun run scripts/clean.ts",
    "clean:all": "bun run scripts/clean.ts -- --nuclear",
    "dev:ios": "cd app && bun ios",
    "dev:android": "cd app && bun android",
    "dev:ios:device": "cd app && bun ios:device",
    "dev:android:device": "cd app && bun android:device",
    "prepush": "bun run lint && bun run type-check && bun run test && bun run build",
    "compile:contract": "contract/compile-contracts.sh",
    "prove": "node --import tsx harness/prove-latency.ts",
    "deploy:preprod": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/deploy-preprod.ts",
    "preprod:balance": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/preprod-balance.ts",
    "preprod:koios": "bun run --tsconfig-override=./harness/tsconfig.json harness/koios-provider-preprod.ts",
    "preprod:send": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/unshielded-send-preprod.ts",
    "preprod:dust": "node --import tsx harness/dust-by-address-preprod.ts",
    "preprod:register-identity": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/register-identity-preprod.ts",
    "preprod:publish-row": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/publish-identity-row-preprod.ts",
    "e2e:local": "node --import tsx harness/deploy-local.ts",
    "e2e:submit-proven": "node --import tsx harness/submit-proven-local.ts",
    "chain:up": "sh infra/standalone/compose.sh up -d",
    "chain:down": "sh infra/standalone/compose.sh down",
    "preprod:deploy-payment": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/deploy-payment-preprod.ts",
    "preprod:mint-token": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/mint-test-token-preprod.ts",
    "preprod:set-price": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/set-price-preprod.ts",
    "preprod:grant-permit": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/grant-permit-preprod.ts",
    "preprod:deploy-circle": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/deploy-circle-preprod.ts",
    "preprod:claim-handle": "NODE_OPTIONS=--max-old-space-size=40960 node --import tsx harness/claim-handle-preprod.ts",
    "build:fork": "bun scripts/build-fork.ts"
  },
  "devDependencies": {
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "tsx": "^4.19.0",
    "@biomejs/biome": "2.3.11",
    "@effect/language-service": "0.67.0",
    "@effect/vitest": "0.27.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@types/node": "25.0.9",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "react-native-unistyles": "3.2.4",
    "typescript": "~6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@pnyx/contract-client": "workspace:*",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/wallet-sdk-utilities": "^1.2.1",
    "effect": "3.21.4"
  },
  "patchedDependencies": {
    "react-native-gesture-handler@2.30.1": "patches/react-native-gesture-handler@2.30.1.patch"
  }
}
